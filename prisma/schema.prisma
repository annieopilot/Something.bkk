// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ingredient {
  id            String   @id @default(cuid())
  name          String
  unit          String   // e.g., 'g', 'ml', 'pcs', 'shots', 'bags'
  tareWeight    Float    @default(0.0) // น้ำหนักบรรจุภัณฑ์/ภาชนะเปล่า (g / ml / unit)
  currentStock  Float    @default(0.0) // สต็อกคงเหลือสุทธิ (Net Stock)
  minStockLevel Float    @default(0.0) // จุดเตือนของใกล้หมด (Reorder Point)
  category      String?  // เช่น กาแฟ, นมและทางเลือก, ไซรัป, ผงเครื่องดื่ม, บรรจุภัณฑ์
  costPerUnit   Float?   @default(0.0) // รองรับการคำนวณต้นทุนต่อหน่วย (Cost of Goods Sold - Future POS)
  supplier      String?  // ผู้จัดจำหน่าย (สำหรับระบบ Reorder ในอนาคต)
  notes         String?  // บันทึกเพิ่มเติม เช่น ยี่ห้อ, ขนาดถุง
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([name])
}
